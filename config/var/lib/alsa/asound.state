state.CPCAP {
	control.1 {
		iface CARD
		name 'Headphones Jack'
		value false
		comment {
			access read
			type BOOLEAN
			count 1
		}
	}
	control.2 {
		iface MIXER
		name 'HiFi Playback Volume'
		value 10
		comment {
			access 'read write'
			type INTEGER
			count 1
			range '0 - 15'
			dbmin -3300
			dbmax 1200
			dbvalue.0 -300
		}
	}
	control.3 {
		iface MIXER
		name 'Voice Playback Volume'
		value 0
		comment {
			access 'read write'
			type INTEGER
