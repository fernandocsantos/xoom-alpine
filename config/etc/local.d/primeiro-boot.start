#!/bin/sh
# Roda uma vez: completa o que o apk não pôde fazer no PC (scripts ARM) e
# aumenta o sistema de arquivos até o tamanho da partição.
M=/var/lib/xoom-primeiro-boot
[ -e $M ] && exit 0

/bin/busybox --install -s
/bin/busybox-extras --install -s 2>/dev/null
# Roda os scripts de pacote que o apk não pôde executar no PC (usuários,
# grupos, gatilhos), reinstalando a partir do cache que vai na imagem
apk fix --reinstall --no-network $(apk info -q 2>/dev/null) > /var/log/primeiro-boot-apk.log 2>&1
for g in wheel audio input video netdev seat; do addgroup xoom $g 2>/dev/null; done
addgroup -S klogd 2>/dev/null
adduser -S -D -H -h /dev/null -s /sbin/nologin -G klogd -g klogd klogd 2>/dev/null
depmod -a
resize2fs /dev/mmcblk0p10 && echo "rootfs aumentado até o tamanho da partição"

mkdir -p /var/lib && date > $M
